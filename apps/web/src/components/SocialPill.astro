---
import { buttonVariants } from '@repo/ui';

interface Props {
  href: string;
  label: string;
  count?: string;
  variant?: 'default' | 'highlight';
  bgClass?: string;
}

const { href, label, count, variant = 'default', bgClass } = Astro.props;

const backgroundStyle = bgClass
  ? bgClass
  : variant === 'highlight'
    ? 'bg-amber-300 hover:bg-amber-400'
    : 'bg-white hover:bg-stone-50';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={buttonVariants({ className: backgroundStyle })}
>
  <slot name="icon" />
  <span>{label}</span>
  {count && (
    <span class="ml-0.5 px-1.5 py-0.2 bg-stone-100 border border-stone-400 text-[10px] text-stone-700">
      {count}
    </span>
  )}
</a>
