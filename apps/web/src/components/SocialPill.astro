---
import { buttonVariants } from '@repo/ui';

interface Props {
  href: string;
  label: string;
  count?: string;
  variant?: 'default' | 'highlight';
  bgClass?: string;
  darkBgClass?: string;
}

const { href, label, count, variant = 'default', bgClass, darkBgClass } = Astro.props;

const backgroundStyle = bgClass
  ? `${bgClass} ${darkBgClass || ''}`.trim()
  : variant === 'highlight'
    ? 'bg-amber-300 hover:bg-amber-400 text-stone-950 dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-stone-950'
    : 'bg-white hover:bg-stone-50 text-stone-900 dark:bg-stone-800 dark:hover:bg-stone-700 dark:text-stone-100';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={buttonVariants({ className: backgroundStyle })}
>
  <slot name="icon" />
  <span>{label}</span>
  {count && (
    <span class="ml-0.5 px-1.5 py-0.2 bg-stone-100 border border-stone-400 text-[10px] text-stone-700 dark:bg-stone-800 dark:border-stone-600 dark:text-stone-200">
      {count}
    </span>
  )}
</a>
