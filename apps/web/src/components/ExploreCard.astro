---
import { cardVariants } from '@repo/ui';

interface Props {
  href: string;
  tag: string;
  count: string;
  title: string;
  description: string;
  actionText: string;
  tagBgColor?: string;
  tagTextColor?: string;
}

const {
  href,
  tag,
  count,
  title,
  description,
  actionText,
  tagBgColor = '#f97316',
  tagTextColor = '#ffffff',
} = Astro.props;
---

<a
  href={href}
  class={cardVariants({ variant: 'interactive', className: 'group h-full p-6 sm:p-7 no-underline relative select-none' })}
>
  <!-- Top Bar: Tag & Count -->
  <div class="flex items-center justify-between gap-2 mb-4">
    <span
      class="px-2.5 py-0.5 font-mono text-[11px] font-black uppercase tracking-wider border border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] dark:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
      style={`background-color: ${tagBgColor}; color: ${tagTextColor};`}
    >
      {tag}
    </span>
    <span class="font-mono text-xs font-bold text-stone-700 dark:text-stone-300 bg-stone-100 dark:bg-stone-800 px-2 py-0.5 border border-stone-300 dark:border-stone-700">
      {count}
    </span>
  </div>

  <!-- Title (Non-italic, bold sans-serif) -->
  <h3 class="font-sans font-black text-2xl text-stone-900 dark:text-stone-100 mb-2 leading-snug tracking-tight not-italic">
    {title}
  </h3>

  <!-- Description -->
  <p class="text-stone-600 dark:text-stone-400 text-sm leading-relaxed mb-6 flex-grow font-sans">
    {description}
  </p>

  <!-- Action Link -->
  <div class="pt-3 border-t-2 border-dashed border-stone-200 dark:border-stone-800 flex items-center justify-between font-mono text-xs font-bold uppercase tracking-wider text-stone-900 dark:text-stone-200 group-hover:text-amber-700 dark:group-hover:text-amber-400">
    <span>{actionText}</span>
    <span class="text-base transition-transform group-hover:translate-x-1.5 leading-none">
      &rarr;
    </span>
  </div>
</a>
