---
import { buttonVariants } from '@repo/ui';
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../utils/url';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: 'Portfolio', href: url('/') },
  { name: 'Notes', href: url('/notes') },
  { name: 'LLD', href: url('/lld') },
  { name: 'Labs', href: url('/labs') },
];

const isActive = (href: string) => {
  if (href === url('/')) return currentPath === url('/') || currentPath === url('/') + '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 bg-[#fdfcfb]/95 dark:bg-[#0c0a09]/95 backdrop-blur-sm border-b-3 border-stone-900 dark:border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 h-18 flex items-center justify-between">
    <!-- Left: Brand / Logo -->
    <a href={url('/')} class="group flex items-center gap-2.5 sm:gap-3 text-stone-900 dark:text-stone-100 no-underline">
      <div class="w-9 h-9 bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 font-silkscreen not-italic font-bold flex items-center justify-center text-lg shadow-[3px_3px_0px_0px_rgba(28,25,23,1)] dark:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
        J
      </div>
      <div class="flex flex-col">
        <span class="font-silkscreen not-italic font-bold text-base sm:text-lg tracking-tight text-stone-900 dark:text-stone-100 leading-none">
          Jyotimoy Kashyap
        </span>
        <span class="font-mono text-[10px] text-stone-500 dark:text-stone-400 tracking-wider uppercase mt-1">
          Systems &amp; Architecture
        </span>
      </div>
    </a>

    <!-- Right Actions & Navigation -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-2">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'px-5 py-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-2',
                active
                  ? 'bg-stone-900 text-white border-stone-900 shadow-[3px_3px_0px_0px_rgba(28,25,23,0.3)] dark:bg-stone-100 dark:text-stone-900 dark:border-stone-100 dark:shadow-[3px_3px_0px_0px_rgba(0,0,0,0.5)]'
                  : 'bg-transparent text-stone-700 dark:text-stone-300 border-transparent hover:border-stone-900 dark:hover:border-stone-100 hover:bg-white dark:hover:bg-stone-800 hover:text-stone-900 dark:hover:text-stone-100 hover:shadow-[3px_3px_0px_0px_rgba(28,25,23,1)] dark:hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-0.5 hover:-translate-y-0.5',
              ]}
            >
              {link.name}
            </a>
          );
        })}

        <!-- External GitHub Link (System Design Labs) -->
        <a
          href="https://github.com/JyotimoyKashyap/system-design-labs"
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ variant: 'accent', size: 'sm', className: 'ml-2' })}
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub ↗
        </a>
      </nav>

      <!-- Mobile Navigation Toggle -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href={url('/labs')}
          class="px-2.5 py-1 font-mono text-[11px] font-bold uppercase bg-stone-900 text-white border-2 border-stone-900 dark:bg-stone-100 dark:text-stone-900 dark:border-stone-100"
        >
          Labs
        </a>
        <a
          href={url('/notes')}
          class="px-2.5 py-1 font-mono text-[11px] font-bold uppercase bg-white text-stone-900 border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] dark:bg-stone-800 dark:text-stone-100 dark:border-stone-700 dark:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
        >
          Notes
        </a>
        <a
          href={url('/lld')}
          class="px-2.5 py-1 font-mono text-[11px] font-bold uppercase bg-white text-stone-900 border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] dark:bg-stone-800 dark:text-stone-100 dark:border-stone-700 dark:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
        >
          LLD
        </a>
      </div>

      <!-- Theme Toggle (Right side on all viewports) -->
      <ThemeToggle />
    </div>
  </div>
</header>

