---
import { url } from '../utils/url';

const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t-3 border-stone-900 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Bio / Manifesto -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 bg-stone-900 text-white font-silkscreen not-italic font-bold flex items-center justify-center text-sm shadow-[2px_2px_0px_0px_rgba(28,25,23,1)]">
            J
          </div>
          <span class="font-silkscreen not-italic font-bold text-base sm:text-lg text-stone-900 leading-none">
            Jyotimoy Kashyap
          </span>
        </div>
        <p class="text-sm text-stone-600 max-w-md leading-relaxed font-sans">
          Software engineer exploring distributed systems, low-level design, and high-performance backend architecture. Building open-source visualizers and practical mental models for complex systems.
        </p>
        <div class="font-mono text-xs text-stone-400">
          Built with Astro 5 • Paper Brutalist Design • 0.00$ AWS Edge Architecture
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-widest text-stone-500 font-bold mb-4">
          Directory
        </h4>
        <ul class="space-y-2 font-mono text-xs">
          <li>
            <a href={url('/')} class="text-stone-700 hover:text-stone-950 hover:underline">
              → Portfolio Home
            </a>
          </li>
          <li>
            <a href={url('/notes')} class="text-stone-700 hover:text-stone-950 hover:underline">
              → System Design Notes
            </a>
          </li>
          <li>
            <a href={url('/lld')} class="text-stone-700 hover:text-stone-950 hover:underline">
              → Low-Level Design (LLD)
            </a>
          </li>
          <li>
            <a href={url('/labs')} class="text-stone-700 hover:text-stone-950 hover:underline">
              → Interactive Visualizers
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Connect & Socials -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-widest text-stone-500 font-bold mb-4">
          Connect
        </h4>
        <ul class="space-y-2 font-mono text-xs">
          <li>
            <a href="https://github.com/JyotimoyKashyap" target="_blank" rel="noopener noreferrer" class="text-stone-700 hover:text-stone-950 hover:underline flex items-center gap-1">
              <span>GitHub</span>
              <span class="text-stone-400">↗</span>
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/jyotimoykashyap" target="_blank" rel="noopener noreferrer" class="text-stone-700 hover:text-stone-950 hover:underline flex items-center gap-1">
              <span>LinkedIn</span>
              <span class="text-stone-400">↗</span>
            </a>
          </li>
          <li>
            <a href="https://x.com/jyotimoykashyap" target="_blank" rel="noopener noreferrer" class="text-stone-700 hover:text-stone-950 hover:underline flex items-center gap-1">
              <span>Twitter / X</span>
              <span class="text-stone-400">↗</span>
            </a>
          </li>
          <li>
            <a href="https://medium.com/@jyotimoykashyap" target="_blank" rel="noopener noreferrer" class="text-stone-700 hover:text-stone-950 hover:underline flex items-center gap-1">
              <span>Medium</span>
              <span class="text-stone-400">↗</span>
            </a>
          </li>
          <li>
            <a href="mailto:contact@jyotimoykashyap.me" class="text-stone-700 hover:text-stone-950 hover:underline flex items-center gap-1">
              <span>Email Me</span>
              <span class="text-stone-400">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t-2 border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-stone-500">
      <div>
        &copy; {currentYear} Jyotimoy Kashyap. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>Always building in the open.</span>
      </div>
    </div>
  </div>
</footer>
