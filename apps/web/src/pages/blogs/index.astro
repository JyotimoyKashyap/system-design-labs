---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogs = (await getCollection('blogs')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
---

<BaseLayout
  title="System Design Blogs • Jyotimoy Kashyap"
  description="Macro-level architectural deep dives into scaling backend systems, connection pooling, and distributed systems."
>
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <header class="pb-8 mb-10 border-b-3 border-stone-900">
      <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold uppercase tracking-wider text-blue-600">
        <span>ARCHITECTURAL WRITINGS</span>
        <span>•</span>
        <span>{blogs.length} ESSAYS</span>
      </div>
      <h1 class="font-serif italic font-black text-4xl sm:text-5xl text-stone-900 mb-3">
        System Design Blogs
      </h1>
      <p class="text-stone-600 text-lg font-sans leading-relaxed">
        Deep dives into high-scale backend architectures, database replication, connection pools, and distributed systems trade-offs.
      </p>
    </header>

    <!-- Blogs List -->
    <div class="space-y-6">
      {blogs.map((post) => (
        <article class="bg-white border-3 border-stone-900 p-6 sm:p-8 shadow-[6px_6px_0px_0px_rgba(28,25,23,1)] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[10px_10px_0px_0px_rgba(28,25,23,1)] transition-all">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-2.5 py-0.5 font-mono text-xs font-black uppercase tracking-wider bg-blue-600 text-white border border-stone-900">
              {post.data.category}
            </span>
            {post.data.readTimeMinutes && (
              <span class="font-mono text-xs font-bold text-stone-600 bg-stone-100 px-2 py-0.5 border border-stone-300">
                {post.data.readTimeMinutes} min read
              </span>
            )}
            <span class="font-mono text-xs text-stone-500 ml-auto">
              {post.data.publishedAt}
            </span>
          </div>

          <h2 class="font-serif italic font-black text-2xl sm:text-3xl text-stone-900 mb-3 leading-snug">
            <a href={`/blogs/${post.id}`} class="hover:text-blue-600 transition-colors no-underline text-stone-900">
              {post.data.title}
            </a>
          </h2>

          <p class="text-stone-600 text-base leading-relaxed mb-6 font-sans">
            {post.data.description}
          </p>

          <div class="pt-4 border-t-2 border-dashed border-stone-200 flex items-center justify-between">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="font-mono text-[11px] text-stone-600 bg-stone-50 px-2 py-0.5 border border-stone-200">
                  #{tag}
                </span>
              ))}
            </div>

            <a
              href={`/blogs/${post.id}`}
              class="font-mono text-xs font-bold uppercase tracking-wider text-blue-600 hover:underline flex items-center gap-1"
            >
              <span>Read Essay</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
