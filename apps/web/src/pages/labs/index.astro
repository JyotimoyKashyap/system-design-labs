---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const labs = await getCollection('labs');
---

<BaseLayout
  title="Interactive Systems Labs • Jyotimoy Kashyap"
  description="In-browser visual simulations of distributed consensus, consistent hashing, append-only logs, and probabilistic data structures."
>
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <header class="pb-8 mb-12 border-b-3 border-stone-900">
      <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold uppercase tracking-wider text-orange-600">
        <span>INTERACTIVE PLAYGROUND</span>
        <span>•</span>
        <span>{labs.length} SIMULATIONS</span>
      </div>
      <h1 class="font-serif italic font-black text-4xl sm:text-5xl text-stone-900 mb-3">
        Interactive Distributed Labs
      </h1>
      <p class="text-stone-600 text-lg font-sans leading-relaxed max-w-3xl">
        Step inside the algorithms. Test node additions, trigger network partitions, inject false positives, and watch distributed systems react in real time.
      </p>
    </header>

    <!-- Labs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {labs.map((lab) => (
        <article class="bg-white border-3 border-stone-900 p-6 sm:p-7 shadow-[6px_6px_0px_0px_rgba(28,25,23,1)] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[10px_10px_0px_0px_rgba(28,25,23,1)] transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span
                class="px-2.5 py-0.5 font-mono text-xs font-black uppercase tracking-wider border border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)]"
                style={`background-color: ${lab.data.tagColor}; color: ${lab.data.tagTextColor};`}
              >
                {lab.data.tag}
              </span>
              <span class="font-mono text-[11px] text-emerald-700 font-bold flex items-center gap-1.5 bg-emerald-50 px-2 py-0.5 border border-emerald-300">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Active
              </span>
            </div>

            <h2 class="font-serif italic font-black text-2xl text-stone-900 mb-2 leading-snug">
              <a href={`/labs/${lab.data.id}`} class="hover:text-orange-600 transition-colors no-underline text-stone-900">
                {lab.data.title}
              </a>
            </h2>

            <p class="text-stone-600 text-sm leading-relaxed mb-6 font-sans">
              {lab.data.description}
            </p>
          </div>

          <div class="pt-4 border-t-2 border-dashed border-stone-200 flex items-center justify-between">
            <span class="font-mono text-xs text-stone-400">
              Browser Simulation
            </span>

            <a
              href={`/labs/${lab.data.id}`}
              class="px-3.5 py-1.5 bg-stone-900 text-white font-mono text-xs font-bold uppercase tracking-wider hover:bg-orange-600 transition-colors border-2 border-stone-900 shadow-[3px_3px_0px_0px_rgba(28,25,23,1)] hover:-translate-x-0.5 hover:-translate-y-0.5 no-underline flex items-center gap-1.5"
            >
              <span>Launch Lab</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
