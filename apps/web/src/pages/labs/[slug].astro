---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import RaftVisualizer from '../../labs/raft-consensus/RaftVisualizer';
import ConsistentHashingVisualizer from '../../labs/consistent-hashing/ConsistentHashingVisualizer';
import BloomFilterVisualizer from '../../labs/bloom-filter/BloomFilterVisualizer';
import RateLimiterVisualizer from '../../labs/api-rate-limiter/RateLimiterVisualizer';
import KafkaVisualizer from '../../labs/apache-kafka/KafkaVisualizer';
import RabbitMQVisualizer from '../../labs/rabbitmq/RabbitMQVisualizer';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map((lab) => ({
    params: { slug: lab.data.id },
    props: { lab },
  }));
}

const { lab } = Astro.props;
---

<BaseLayout
  title={`${lab.data.title} • Interactive Lab`}
  description={lab.data.description}
  fullscreen={true}
>
  <div class="flex flex-col h-[calc(100vh-73px)] bg-[#fdfcfb]">
    <!-- Top Action Toolbar -->
    <div class="bg-white border-b-3 border-stone-900 px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 shrink-0 z-30">
      <div class="flex items-center gap-3">
        <a
          href="/labs"
          class="px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-stone-900 bg-stone-100 border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all no-underline flex items-center gap-1"
        >
          <span>&larr;</span>
          <span>Labs Directory</span>
        </a>

        <div class="h-4 w-[2px] bg-stone-300 hidden sm:block"></div>

        <div class="flex items-center gap-2">
          <span
            class="px-2 py-0.5 font-mono text-[10px] font-black uppercase tracking-wider border border-stone-900 shadow-[1px_1px_0px_0px_rgba(28,25,23,1)]"
            style={`background-color: ${lab.data.tagColor}; color: ${lab.data.tagTextColor};`}
          >
            {lab.data.tag}
          </span>
          <h1 class="font-silkscreen not-italic font-bold text-sm sm:text-base text-stone-900 leading-none">
            {lab.data.title}
          </h1>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="font-mono text-xs text-stone-500 hidden md:inline">
          Interactive Simulation
        </span>
        <a
          href={`https://github.com/JyotimoyKashyap/system-design-labs/tree/main/${lab.data.id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1 font-mono text-xs font-bold text-stone-900 border-2 border-stone-900 hover:bg-stone-100 no-underline shadow-[2px_2px_0px_0px_rgba(28,25,23,1)]"
        >
          GitHub Repo ↗
        </a>
      </div>
    </div>

    <!-- Main Interactive Simulation Island View -->
    <div class="flex-1 w-full h-full min-h-0 relative overflow-hidden bg-[#fdfcfb]">
      {lab.data.id === 'raft-consensus' && <RaftVisualizer client:only="react" />}
      {lab.data.id === 'consistent-hashing' && <ConsistentHashingVisualizer client:only="react" />}
      {lab.data.id === 'bloom-filter' && <BloomFilterVisualizer client:only="react" />}
      {lab.data.id === 'api-rate-limiter' && <RateLimiterVisualizer client:only="react" />}
      {lab.data.id === 'apache-kafka' && <KafkaVisualizer client:only="react" />}
      {lab.data.id === 'rabbitmq' && <RabbitMQVisualizer client:only="react" />}
    </div>
  </div>
</BaseLayout>
