---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lldList = (await getCollection('lld')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
---

<BaseLayout
  title="Low-Level Design (LLD) • Jyotimoy Kashyap"
  description="Production-grade object-oriented low-level design patterns, thread-safe caches, and event-driven architectures."
>
  <div class="w-full">
    <!-- Header -->
    <header class="pb-8 mb-10 border-b-3 border-stone-900">
      <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold uppercase tracking-wider text-pink-600">
        <span>OBJECT-ORIENTED CASE STUDIES</span>
        <span>•</span>
        <span>{lldList.length} DESIGNS</span>
      </div>
      <h1 class="font-serif italic font-black text-4xl sm:text-5xl text-stone-900 mb-3">
        Low-Level Design (LLD)
      </h1>
      <p class="text-stone-600 text-lg font-sans leading-relaxed">
        Clean code, extensible domain models, and high-concurrency patterns modeled from first principles in Java and TypeScript.
      </p>
    </header>

    <!-- LLD Grid (Matching Visualizers / Labs Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {lldList.map((item) => (
        <article class="bg-white border-3 border-stone-900 p-6 sm:p-7 shadow-[8px_8px_0px_0px_rgba(28,25,23,1)] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(28,25,23,1)] transition-all flex flex-col justify-between">
          <div>
            <!-- Top Badges & Meta -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 font-mono text-xs font-black uppercase tracking-wider bg-pink-600 text-white border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)]">
                {item.data.language}
              </span>
              <span class="font-mono text-xs font-bold text-stone-700 bg-stone-100 px-2 py-0.5 border border-stone-300">
                Difficulty: {item.data.difficulty}
              </span>
            </div>

            <!-- Card Title: Non-italic, bold sans-serif -->
            <h2 class="font-sans font-black text-2xl text-stone-900 mb-3 leading-snug tracking-tight not-italic">
              <a href={`/lld/${item.id}`} class="hover:text-pink-600 transition-colors no-underline text-stone-900">
                {item.data.title}
              </a>
            </h2>

            <p class="text-stone-700 text-sm leading-relaxed mb-5 font-sans">
              {item.data.description}
            </p>

            <!-- Design Patterns Tags -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {item.data.designPatterns.map((pattern) => (
                <span class="font-mono text-[11px] text-stone-700 bg-stone-50 px-2 py-0.5 border border-stone-300">
                  {pattern}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Actions with Signature Boxy Brutalist Buttons -->
          <div class="pt-4 border-t-2 border-stone-100 flex items-center justify-between gap-3">
            <a
              href={`/lld/${item.id}`}
              class="px-4 py-2 bg-[#4ECDC4] text-stone-950 font-mono text-xs font-black uppercase tracking-wider border-3 border-stone-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] no-underline transition-all"
            >
              Read Design &rarr;
            </a>

            {item.data.githubRepo && (
              <a
                href={item.data.githubRepo}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs font-bold text-stone-600 hover:text-stone-900 underline"
              >
                GitHub ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
