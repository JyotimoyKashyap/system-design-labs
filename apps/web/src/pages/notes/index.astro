---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
---

<BaseLayout
  title="System Design Notes • Jyotimoy Kashyap"
  description="Technical notes, architectural explorations, and deep dives into distributed systems and high-concurrency patterns."
>
  <div class="w-full">
    <!-- Header -->
    <header class="pb-8 mb-12 border-b-3 border-stone-900">
      <div class="flex items-center gap-2 mb-2 font-mono text-xs font-bold uppercase tracking-wider text-blue-600">
        <span>ENGINEERING NOTES</span>
        <span>•</span>
        <span>{notes.length} {notes.length === 1 ? 'NOTE' : 'NOTES'}</span>
      </div>
      <h1 class="font-serif italic font-black text-4xl sm:text-5xl text-stone-900 mb-3">
        System Design Notes
      </h1>
      <p class="text-stone-600 text-lg font-sans leading-relaxed max-w-3xl">
        Technical notes, architectural explorations, and deep dives into high-scale systems trade-offs and backend design.
      </p>
    </header>

    <!-- Notes Grid (Matching LLD and Labs Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {notes.map((note) => (
        <article class="bg-white border-3 border-stone-900 p-6 sm:p-7 shadow-[8px_8px_0px_0px_rgba(28,25,23,1)] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(28,25,23,1)] transition-all flex flex-col justify-between">
          <div>
            <!-- Top Badges & Meta -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 font-mono text-xs font-black uppercase tracking-wider bg-blue-600 text-white border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)]">
                {note.data.category}
              </span>
              {note.data.readTimeMinutes && (
                <span class="font-mono text-xs font-bold text-stone-700 bg-stone-100 px-2 py-0.5 border border-stone-300">
                  {note.data.readTimeMinutes} min read
                </span>
              )}
            </div>

            <!-- Card Title: Non-italic, bold sans-serif -->
            <h2 class="font-sans font-black text-2xl text-stone-900 mb-3 leading-snug tracking-tight not-italic">
              <a href={`/notes/${note.id}`} class="hover:text-blue-600 transition-colors no-underline text-stone-900">
                {note.data.title}
              </a>
            </h2>

            <p class="text-stone-700 text-sm leading-relaxed mb-5 font-sans">
              {note.data.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {note.data.tags.map((tag) => (
                <span class="font-mono text-[11px] text-stone-700 bg-stone-50 px-2 py-0.5 border border-stone-300">
                  #{tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Actions with Signature Boxy Brutalist Button -->
          <div class="pt-4 border-t-2 border-stone-100 flex items-center justify-between gap-3">
            <a
              href={`/notes/${note.id}`}
              class="px-4 py-2 bg-[#4ECDC4] text-stone-950 font-mono text-xs font-black uppercase tracking-wider border-3 border-stone-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] no-underline transition-all"
            >
              Read Note &rarr;
            </a>

            <span class="font-mono text-xs text-stone-500 font-bold">
              {note.data.publishedAt}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
