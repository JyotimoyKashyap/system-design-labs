---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialPill from '../components/SocialPill.astro';
import ExploreCard from '../components/ExploreCard.astro';
import { getCollection } from 'astro:content';
import { buttonVariants, cardVariants } from '@repo/ui';
import { url } from '../utils/url';

const notes = (await getCollection('notes')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const lldList = (await getCollection('lld')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const labs = await getCollection('labs');
---

<BaseLayout>
  <!-- 1. HERO SECTION (Two-Column Layout inspired by Arpit Bhayani) -->
  <section class="pb-16 border-b-3 border-stone-900 dark:border-stone-800 mb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- Left Column: Narrative Bio & Links (8 of 12 cols) -->
      <div class="lg:col-span-8 space-y-6">
        <div>
          <h1 class="font-silkscreen not-italic text-3xl sm:text-5xl text-stone-900 dark:text-stone-100 tracking-tight leading-tight mb-3">
            Hey, I am Jyotimoy
          </h1>
          <h2 class="font-silkscreen not-italic text-sm sm:text-base text-orange-600 dark:text-orange-500 leading-relaxed">
            engineering, distributed systems, and low-level design. always building.
          </h2>
        </div>

        <!-- Narrative Paragraphs -->
        <div class="space-y-4 text-stone-700 dark:text-stone-300 text-base sm:text-lg leading-relaxed font-sans">
          <p>
            I am a software engineer passionate about <strong>distributed systems</strong>, high-throughput backend architectures, and database internals. I focus on building reliable systems that scale predictably and exploring the fundamental trade-offs in modern computing.
          </p>
          <p>
            I run <a href="https://github.com/JyotimoyKashyap/system-design-labs" target="_blank" class="text-stone-950 dark:text-stone-100 font-bold underline decoration-2 decoration-orange-500 hover:text-orange-600 dark:hover:text-orange-400">System Design Labs</a>, an open-source initiative dedicated to demystifying complex distributed algorithms—such as <strong>Raft consensus</strong>, <strong>consistent hashing rings</strong>, <strong>append-only logs</strong>, and <strong>probabilistic data structures</strong>—through interactive visual simulations and in-depth writeups.
          </p>
          <p>
            On the low-level side, I dissect <strong>Low-Level Design (LLD)</strong> problems from first principles—designing concurrent in-memory caches with lock striping, event-sourced notification buses, and enterprise task management engines.
          </p>
          <p>
            I believe the best way to understand systems is to break them down visually, test their edge cases, and share the learnings in the open.
          </p>
        </div>

        <!-- Social Buttons Group -->
        <div class="pt-2 flex flex-wrap gap-2.5 sm:gap-3">
          <!-- GitHub (Personal Portfolio) -->
          <SocialPill
            href="https://github.com/JyotimoyKashyap"
            label="GitHub"
            bgClass="bg-[#FCD34D] hover:bg-[#FBBF24] text-stone-950 dark:bg-[#FBBF24] dark:hover:bg-[#F59E0B] dark:text-stone-950"
          >
            <svg slot="icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </SocialPill>

          <!-- LinkedIn -->
          <SocialPill
            href="https://linkedin.com/in/jyotimoykashyap"
            label="LinkedIn"
            bgClass="bg-[#93C5FD] hover:bg-[#60A5FA] text-stone-950 dark:bg-[#60A5FA] dark:hover:bg-[#3B82F6] dark:text-stone-950"
          >
            <svg slot="icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </SocialPill>

          <!-- Twitter / X -->
          <SocialPill
            href="https://x.com/jyotimoykashyap"
            label="Twitter / X"
            bgClass="bg-[#DDD6FE] hover:bg-[#C4B5FD] text-stone-950 dark:bg-[#C4B5FD] dark:hover:bg-[#A78BFA] dark:text-stone-950"
          >
            <svg slot="icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </SocialPill>

          <!-- Medium -->
          <SocialPill
            href="https://medium.com/@jyotimoykashyap"
            label="Medium"
            bgClass="bg-[#FED7AA] hover:bg-[#FDBA74] text-stone-950 dark:bg-[#FDBA74] dark:hover:bg-[#FB923C] dark:text-stone-950"
          >
            <svg slot="icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
            </svg>
          </SocialPill>

          <!-- Email / Contact -->
          <SocialPill
            href="mailto:contact@jyotimoykashyap.me"
            label="Contact"
            bgClass="bg-[#86EFAC] hover:bg-[#4ADE80] text-stone-950 dark:bg-[#4ADE80] dark:hover:bg-[#22C55E] dark:text-stone-950"
          >
            <svg slot="icon" class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </SocialPill>
        </div>
      </div>

      <!-- Right Column: Brutalist Profile Frame (4 of 12 cols) -->
      <div class="lg:col-span-4 flex flex-col items-center lg:items-end">
        <div class="w-full max-w-[320px] bg-white dark:bg-stone-900 border-3 border-stone-900 dark:border-stone-700 p-3 shadow-[8px_8px_0px_0px_rgba(28,25,23,1)] dark:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
          <div class="w-full aspect-square border-2 border-stone-900 dark:border-stone-700 overflow-hidden bg-stone-100 dark:bg-stone-800 flex items-center justify-center">
            <img
              src={url('/profile.svg')}
              alt="Jyotimoy Kashyap"
              class="w-full h-full object-cover select-none"
              loading="eager"
            />
          </div>
          <div class="mt-3 pt-2 border-t-2 border-dashed border-stone-200 dark:border-stone-800 flex items-center justify-between font-mono text-[11px] text-stone-600 dark:text-stone-400">
            <span class="font-bold">STATUS:</span>
            <span class="text-emerald-700 dark:text-emerald-400 flex items-center gap-1 font-bold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Architecting &amp; Writing
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. EXPLORE WORK & WRITINGS SECTION -->
  <section class="mb-20">
    <div class="mb-8">
      <h2 class="font-silkscreen not-italic text-2xl sm:text-3xl text-stone-900 dark:text-stone-100 leading-tight">
        Explore Work &amp; Writings
      </h2>
      <p class="text-stone-600 dark:text-stone-400 text-base font-sans mt-1">
        Everything I build, write, publish, and engineer in the open.
      </p>
    </div>

    <!-- 4 Category Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <ExploreCard
        href={url('/labs')}
        tag="INTERACTIVE"
        count={`${labs.length} Labs`}
        title="Interactive Labs"
        description="Visual in-browser simulations of Raft elections, Consistent Hashing rings, Bloom filters, and message queues."
        actionText="Launch labs"
        tagBgColor="#f97316"
      />

      <ExploreCard
        href={url('/notes')}
        tag="ARCHITECTURE"
        count={`${notes.length} ${notes.length === 1 ? 'Note' : 'Notes'}`}
        title="System Design Notes"
        description="Architectural deep dives, notes, and exploratory writeups from building scalable backend systems."
        actionText="Read notes"
        tagBgColor="#2563eb"
      />

      <ExploreCard
        href={url('/lld')}
        tag="OBJECT-ORIENTED"
        count={`${lldList.length} Studies`}
        title="Low-Level Design"
        description="Production-grade object-oriented patterns, thread-safe in-memory cache architectures, and domain-driven design."
        actionText="Explore LLD"
        tagBgColor="#ec4899"
      />

      <ExploreCard
        href="https://github.com/JyotimoyKashyap/system-design-labs"
        tag="OPEN SOURCE"
        count="Monorepo"
        title="System Design Labs"
        description="Containerized Docker topologies, Spring Boot microservices, Kafka cluster nodes, and Redis caches."
        actionText="View repository"
        tagBgColor="#10b981"
      />
    </div>
  </section>

  <!-- 3. LIVE SHOWROOM: INTERACTIVE LABS & NOTES (Exact Paper Brutalist Style from Old Site) -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <!-- Left Column: Interactive Labs (7 of 12 cols) -->
    <div class="lg:col-span-7">
      <div class="flex items-baseline justify-between border-b-3 border-stone-900 dark:border-stone-800 pb-3 mb-8">
        <h2 class="font-silkscreen not-italic text-2xl sm:text-3xl text-stone-900 dark:text-stone-100">
          Interactive Labs
        </h2>
        <a href={url('/labs')} class="font-mono text-xs font-bold text-orange-600 dark:text-orange-500 hover:underline uppercase tracking-wider">
          All Labs ({labs.length}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {labs.slice(0, 4).map((lab) => (
          <div class={cardVariants({ variant: 'interactive', className: 'p-6 sm:p-7' })}>
            <div>
              <span
                class="inline-block px-3 py-1 font-mono text-[11px] font-black uppercase tracking-wider border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] dark:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4"
                style={`background-color: ${lab.data.tagColor}; color: ${lab.data.tagTextColor};`}
              >
                {lab.data.tag}
              </span>

              <!-- Non-italic, bold sans-serif card title -->
              <h3 class="font-sans font-black text-xl sm:text-2xl text-stone-900 dark:text-stone-100 mb-3 leading-snug tracking-tight not-italic">
                {lab.data.title}
              </h3>

              <p class="text-stone-700 dark:text-stone-300 text-sm leading-relaxed mb-6 font-sans">
                {lab.data.description}
              </p>
            </div>

            <!-- Buttons: LAUNCH APP (#FF6B6B) & READ DOCS (#4ECDC4) -->
            <div class="flex flex-wrap gap-3 pt-4 border-t-2 border-stone-100 dark:border-stone-800">
              <a
                href={url(`/labs/${lab.data.id}`)}
                class={buttonVariants({ variant: 'primary' })}
              >
                Launch App
              </a>
              <a
                href={url(`/labs/${lab.data.id}/docs`)}
                class={buttonVariants({ variant: 'secondary' })}
              >
                Read Docs
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Notes & LLD (5 of 12 cols) -->
    <div class="lg:col-span-5">
      <div class="border-b-3 border-stone-900 dark:border-stone-800 pb-3 mb-8">
        <h2 class="font-silkscreen not-italic text-2xl sm:text-3xl text-stone-900 dark:text-stone-100">
          Notes &amp; LLD
        </h2>
      </div>

      <div class="space-y-6">
        {notes.slice(0, 1).map((note) => (
          <div class={cardVariants({ variant: 'interactive', className: 'p-6 sm:p-7' })}>
            <div>
              <span class="inline-block px-3 py-1 font-mono text-[11px] font-black uppercase tracking-wider bg-blue-600 text-white border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] dark:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
                {note.data.category}
              </span>

              <!-- Non-italic, bold sans-serif card title -->
              <h3 class="font-sans font-black text-xl sm:text-2xl text-stone-900 dark:text-stone-100 mb-3 leading-snug tracking-tight not-italic">
                {note.data.title}
              </h3>

              <p class="text-stone-700 dark:text-stone-300 text-sm leading-relaxed mb-6 font-sans">
                {note.data.description}
              </p>
            </div>

            <div class="pt-4 border-t-2 border-stone-100 dark:border-stone-800 flex items-center justify-between">
              <a
                href={url(`/notes/${note.id}`)}
                class={buttonVariants({ variant: 'secondary' })}
              >
                Read Note
              </a>
              <span class="font-mono text-xs text-stone-500 dark:text-stone-400 font-bold">
                {note.data.publishedAt}
              </span>
            </div>
          </div>
        ))}

        {lldList.slice(0, 2).map((item) => (
          <div class={cardVariants({ variant: 'interactive', className: 'p-6 sm:p-7' })}>
            <div>
              <span class="inline-block px-3 py-1 font-mono text-[11px] font-black uppercase tracking-wider bg-[#ec4899] text-white border-2 border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] dark:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
                {item.data.language} • {item.data.difficulty}
              </span>

              <!-- Non-italic, bold sans-serif card title -->
              <h3 class="font-sans font-black text-xl sm:text-2xl text-stone-900 dark:text-stone-100 mb-3 leading-snug tracking-tight not-italic">
                {item.data.title}
              </h3>

              <p class="text-stone-700 dark:text-stone-300 text-sm leading-relaxed mb-6 font-sans">
                {item.data.description}
              </p>
            </div>

            <div class="pt-4 border-t-2 border-stone-100 dark:border-stone-800 flex items-center justify-between">
              <a
                href={url(`/lld/${item.id}`)}
                class={buttonVariants({ variant: 'secondary' })}
              >
                Read Design
              </a>
              <span class="font-mono text-xs text-stone-500 dark:text-stone-400 font-bold">
                {item.data.publishedAt}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </section>
</BaseLayout>
