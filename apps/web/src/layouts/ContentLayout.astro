---
import BaseLayout from './BaseLayout.astro';
import { buttonVariants, cardVariants } from '@repo/ui';
import { url } from '../utils/url';

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  category?: string;
  tags?: string[];
  backLink: string;
  backLabel: string;
  readTimeMinutes?: number;
  githubRepo?: string;
  launchAppLink?: string;
  launchAppLabel?: string;
}

const {
  title,
  description,
  publishedAt,
  category = 'System Design',
  tags = [],
  backLink,
  backLabel,
  readTimeMinutes,
  githubRepo,
  launchAppLink,
  launchAppLabel,
} = Astro.props;
---

<BaseLayout title={`${title} • Jyotimoy Kashyap`} description={description}>
  <div class="w-full">
    <!-- Top Nav Action Bar -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <a
        href={url(backLink)}
        class={buttonVariants({ variant: 'tertiary', size: 'sm', className: 'bg-stone-100 dark:bg-stone-800 dark:text-stone-100' })}
      >
        <span>&larr;</span>
        <span>{backLabel}</span>
      </a>

      {launchAppLink && (
        <a
          href={url(launchAppLink)}
          class={buttonVariants({ variant: 'primary', size: 'sm' })}
        >
          <span>🚀</span>
          <span>{launchAppLabel || 'Launch Interactive App'}</span>
        </a>
      )}
    </div>

    <!-- Article Shell (Paper Brutalist Card) -->
    <article class={cardVariants({ variant: 'default', className: 'p-6 sm:p-12 lg:p-14' })}>
      <!-- Article Header -->
      <header class="pb-8 mb-8 border-b-3 border-stone-900 dark:border-stone-800">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="px-2.5 py-0.5 font-mono text-xs font-black uppercase tracking-wider bg-orange-500 text-white border border-stone-900 shadow-[2px_2px_0px_0px_rgba(28,25,23,1)] dark:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            {category}
          </span>
          {readTimeMinutes && (
            <span class="font-mono text-xs font-bold text-stone-600 dark:text-stone-300 bg-stone-100 dark:bg-stone-800 px-2 py-0.5 border border-stone-300 dark:border-stone-700">
              {readTimeMinutes} min read
            </span>
          )}
          <span class="font-mono text-xs text-stone-500 dark:text-stone-400 ml-auto">
            {publishedAt}
          </span>
        </div>

        <h1 class="font-silkscreen not-italic text-2xl sm:text-4xl text-stone-900 dark:text-stone-100 mb-4 leading-tight">
          {title}
        </h1>

        <p class="text-stone-600 dark:text-stone-400 text-lg leading-relaxed font-sans mb-6">
          {description}
        </p>

        <!-- Tags & Links -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t-2 border-dashed border-stone-200 dark:border-stone-800">
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class="font-mono text-[11px] text-stone-700 dark:text-stone-300 bg-stone-100 dark:bg-stone-800 px-2 py-0.5 border border-stone-300 dark:border-stone-700">
                #{tag}
              </span>
            ))}
          </div>

          {githubRepo && (
            <a
              href={githubRepo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-stone-900 dark:text-stone-200 hover:text-amber-600 dark:hover:text-amber-400 underline"
            >
              <span>View Source on GitHub</span>
              <span>↗</span>
            </a>
          )}
        </div>
      </header>

      <!-- Markdown Body Content (Clean Sans-Serif Headers, Tables, Code) -->
      <div class="markdown-body w-full">
        <slot />
      </div>
    </article>
  </div>

  <!-- Mermaid Client-Side Renderer with Paper Brutalist Theme Support -->
  <script>
    let isRendering = false;
    let pendingThemeChange = false;

    function getMermaidConfig(isDark: boolean) {
      return {
        startOnLoad: false,
        securityLevel: 'loose' as const,
        fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        theme: 'base' as const,
        themeVariables: isDark
          ? {
              darkMode: true,
              background: '#141210',
              mainBkg: '#1c1917',
              primaryColor: '#1c1917',
              primaryTextColor: '#fdfcfb',
              primaryBorderColor: '#57534e',
              lineColor: '#a8a29e',
              secondaryColor: '#292524',
              secondaryTextColor: '#fdfcfb',
              secondaryBorderColor: '#57534e',
              tertiaryColor: '#141210',
              tertiaryTextColor: '#fdfcfb',
              tertiaryBorderColor: '#57534e',
              nodeBorder: '#57534e',
              nodeTextColor: '#fdfcfb',
              clusterBkg: '#141210',
              clusterBorder: '#44403c',
              defaultLinkColor: '#a8a29e',
              titleColor: '#fdfcfb',
              edgeLabelBackground: '#1c1917',
              actorBorder: '#57534e',
              actorBkg: '#1c1917',
              actorTextColor: '#fdfcfb',
              actorLineColor: '#a8a29e',
              signalColor: '#a8a29e',
              signalTextColor: '#fdfcfb',
              labelBoxBkgColor: '#1c1917',
              labelBoxBorderColor: '#57534e',
              labelTextColor: '#fdfcfb',
              loopTextColor: '#fdfcfb',
              noteBorderColor: '#fbbf24',
              noteBkgColor: '#292524',
              noteTextColor: '#fbbf24',
              activationBorderColor: '#f97316',
              activationBkgColor: '#292524',
              sequenceNumberColor: '#0c0a09',
              classText: '#fdfcfb',
            }
          : {
              darkMode: false,
              background: '#ffffff',
              mainBkg: '#f5f4f0',
              primaryColor: '#f5f4f0',
              primaryTextColor: '#1c1917',
              primaryBorderColor: '#1c1917',
              lineColor: '#1c1917',
              secondaryColor: '#fafaf9',
              secondaryTextColor: '#1c1917',
              secondaryBorderColor: '#1c1917',
              tertiaryColor: '#ffffff',
              tertiaryTextColor: '#1c1917',
              tertiaryBorderColor: '#1c1917',
              nodeBorder: '#1c1917',
              nodeTextColor: '#1c1917',
              clusterBkg: '#fafaf9',
              clusterBorder: '#1c1917',
              defaultLinkColor: '#1c1917',
              titleColor: '#1c1917',
              edgeLabelBackground: '#ffffff',
              actorBorder: '#1c1917',
              actorBkg: '#f5f4f0',
              actorTextColor: '#1c1917',
              actorLineColor: '#1c1917',
              signalColor: '#1c1917',
              signalTextColor: '#1c1917',
              labelBoxBkgColor: '#f5f4f0',
              labelBoxBorderColor: '#1c1917',
              labelTextColor: '#1c1917',
              loopTextColor: '#1c1917',
              noteBorderColor: '#1c1917',
              noteBkgColor: '#fef3c7',
              noteTextColor: '#1c1917',
              activationBorderColor: '#1c1917',
              activationBkgColor: '#ffedd5',
              sequenceNumberColor: '#ffffff',
              classText: '#1c1917',
            },
      };
    }

    async function initMermaid() {
      const mermaidNodes = document.querySelectorAll<HTMLElement>(
        'pre[data-language="mermaid"], pre > code.language-mermaid, .language-mermaid'
      );
      for (let i = 0; i < mermaidNodes.length; i++) {
        const node = mermaidNodes[i];
        const pre = node.tagName.toLowerCase() === 'pre' ? node : node.closest('pre') || node;
        if (pre.closest('.mermaid-wrapper')) continue;
        const code = pre.textContent?.trim() || '';
        if (!code) continue;

        const wrapper = document.createElement('div');
        wrapper.className = 'mermaid-wrapper my-8 py-2 flex justify-center overflow-x-auto';
        wrapper.dataset.mermaidCode = code;
        pre.replaceWith(wrapper);
      }

      await renderAllMermaids();
    }

    async function renderAllMermaids() {
      if (isRendering) {
        pendingThemeChange = true;
        return;
      }
      isRendering = true;

      const wrappers = document.querySelectorAll<HTMLElement>('.mermaid-wrapper[data-mermaid-code]');
      if (wrappers.length === 0) {
        isRendering = false;
        return;
      }

      try {
        const { default: mermaid } = await import('mermaid');
        const isDark = document.documentElement.classList.contains('dark');
        mermaid.initialize(getMermaidConfig(isDark));

        for (let i = 0; i < wrappers.length; i++) {
          const wrapper = wrappers[i];
          const code = wrapper.dataset.mermaidCode;
          if (!code) continue;

          try {
            const id = `mermaid-${Date.now()}-${i}-${Math.random().toString(36).substring(2, 7)}`;
            const { svg } = await mermaid.render(id, code);
            wrapper.innerHTML = svg;
          } catch (err) {
            console.warn('Mermaid rendering skipped for block', i, err);
          }
        }
      } catch (e) {
        console.error('Failed to load or render mermaid diagrams', e);
      } finally {
        isRendering = false;
        if (pendingThemeChange) {
          pendingThemeChange = false;
          renderAllMermaids();
        }
      }
    }

    let lastTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    const themeObserver = new MutationObserver(() => {
      const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      if (currentTheme !== lastTheme) {
        lastTheme = currentTheme;
        renderAllMermaids();
      }
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    window.addEventListener('theme-changed', () => {
      const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      if (currentTheme !== lastTheme) {
        lastTheme = currentTheme;
        renderAllMermaids();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMermaid);
    } else {
      initMermaid();
    }
    document.addEventListener('astro:page-load', initMermaid);
  </script>
</BaseLayout>
