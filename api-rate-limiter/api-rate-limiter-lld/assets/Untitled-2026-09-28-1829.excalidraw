      "updated": 1790933737115,
      "created": 1790688165619,
      "link": null,
      "locked": false,
      "text": "For a bucket the\nconfigurable options are\nits capacity and the\nrefill rate",
      "fontSize": 20,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "wPINUnuT4zRAvu_7AfaVr",
      "originalText": "For a bucket the configurable options are its capacity and the refill rate",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
