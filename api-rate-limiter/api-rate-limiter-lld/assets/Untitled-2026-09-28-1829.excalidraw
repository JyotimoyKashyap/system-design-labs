      "created": 1790687754886,
      "link": null,
      "locked": false,
      "text": "There can be an\n`AbstractApiRateLimit\ner` but we don't know\nwhat common logic it\nwould hold as of now\nhence we will be\nskipping it for now. ",
      "fontSize": 24.607795791652293,
      "baseFontSize": 38.60779579165229,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "7iDqnrjSZ21ThRmwwiIbg",
      "originalText": "There can be an `AbstractApiRateLimiter` but we don't know what common logic it would hold as of now hence we will be skipping it for now. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
