    {
      "id": "lY3sJwA5z75bDzw5mMHxn",
      "type": "text",
      "x": 1529.5133158716922,
      "y": -96.91724603918007,
      "width": 190.03182983398438,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
