      "version": 739,
      "versionNonce": 24641606,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790933621678,
      "created": 1790604995827,
      "link": null,
      "locked": false,
      "text": "Amazon has API\nGateway, which also has\nRate Limiter so for High\nLevel Design we can\nthink about this as as\nthe rate limiter here\ninside API Gateway",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "j_Ua3pzPIzy5tG_BOCbNm",
      "originalText": "Amazon has API Gateway, which also has Rate Limiter so for High Level Design we can think about this as as the rate limiter here inside API Gateway",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
