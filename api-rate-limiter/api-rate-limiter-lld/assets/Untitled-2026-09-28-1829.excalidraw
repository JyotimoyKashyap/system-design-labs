      "created": 1790605946388,
      "link": null,
      "locked": false,
      "text": "One Rate Limiter is not\nenough in a DC then we\nmight want to\nhorizontally scale it",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "pdvmIBum8Q1jV3oLM4Q2F",
      "originalText": "One Rate Limiter is not enough in a DC then we might want to horizontally scale it",
      "autoResize": true,
