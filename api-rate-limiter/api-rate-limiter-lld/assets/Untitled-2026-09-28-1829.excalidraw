      "isDeleted": false,
      "boundElements": [],
      "updated": 1790934933212,
      "created": 1790916036701,
      "link": null,
      "locked": false,
      "text": "This class will hold the\ninformation about each\nindividual client's bucket\ninformation. \n\nThe no. of tokens that\nneeds to be refilled is\ncalculated on demand when\nnew request arrives",
      "fontSize": 18,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Cex7vJS-qEsa8-WqGi8XH",
      "originalText": "This class will hold the information about each individual client's bucket information. \n\nThe no. of tokens that needs to be refilled is calculated on demand when new request arrives",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
